# ===================================================================
# Database Configuration (PostgreSQL 16 + pgvector)
# ===================================================================
POSTGRES_DB=jd_matching_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password_db_secret
POSTGRES_PORT=5433

# ===================================================================
# Backend Service Configuration (Java 17 + Spring Boot 3.2.x)
# ===================================================================
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-vector:5432/jd_matching_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=password_db_secret
AI_ENGINE_URL=http://ai-engine:8001

# ===================================================================
# AI Engine Configuration (Python 3.10+ + FastAPI)
# ===================================================================
AI_ENGINE_PORT=8001
DATABASE_URL=postgresql://postgres:password_db_secret@postgres-vector:5432/jd_matching_db
GEMINI_API_KEY=your_gemini_api_key_here
GITHUB_PERSONAL_TOKEN=
EMBEDDING_MODEL_NAME=BAAI/bge-m3
